# ─────────────────────────────────────────────────────────────────────────────
# Copia questo file in `.env.local` e riempi i valori.
# `.env.local` è escluso dal versionamento: non finirà mai su GitHub.
# Nessun valore va incollato in chat.
# ─────────────────────────────────────────────────────────────────────────────

# CATEGORIA: PUBBLICA — progettata per stare nel browser, nessun rischio.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# CATEGORIA: DI SVILUPPO — alto rischio ma circoscritto e revocabile.
# Serve solo sul computer di sviluppo per applicare le migrazioni.
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# CATEGORIA: DI RUNTIME PRIVILEGIATA — 🔴 NON deve stare in questo progetto.
# La service_role key scavalca ogni regola di sicurezza: si usa solo dentro
# le Edge Functions, dove il backend la inietta da solo.
# NON aggiungerla qui.
